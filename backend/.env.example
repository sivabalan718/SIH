# ==========================================
# M63 Backend Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ==========================================
# Supabase Server-Only Credentials
# ==========================================

SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================
# M63 AI — Gemini
# ==========================================

GEMINI_API_KEY=your_gemini_api_key_here

# Model configuration
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_LLM_MODEL=gemini-3.7-flash

# ==========================================
# M63 AI — Google Cloud Speech-to-Text
# ==========================================

GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=your_google_credentials_json_path_here

# ==========================================
# M63 AI — Development / Testing
# ==========================================

M63_AI_MOCK_MODE=false

# ==========================================
# M63 AI — Cloudinary Studio & Storage
# ==========================================

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ==========================================
# Optional Future Provider Placeholders
# ==========================================

TRANSLATION_API_KEY=
IMAGE_AI_API_KEY=