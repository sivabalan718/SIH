{
  "name": "m63-backend",
  "version": "1.0.0",
  "description": "M63 Artisan Platform Backend API",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
