    "catalogue:backfill": "tsx src/scripts/backfillCatalogues.ts"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@supabase/supabase-js": "^2.45.4",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "multer": "^2.3.0",
    "sharp": "^0.35.4",
    "zod": "^3.23.8"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2"
  }
